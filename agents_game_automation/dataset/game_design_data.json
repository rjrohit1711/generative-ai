{
  "game_info": {
    "name": "Apple Hop",
    "version": "1.1.0",
    "description": "Start screen shows twilight forest with soft orange-violet gradient sky.",
    "start_screen": {
      "title_text": "Apple Hop",
      "subtitle_text": "Press Enter to Play",
      "font": { "family": "ArcadeClassic", "size": 48, "color": "#FFA500" },
      "background": {
        "assert_path": "./assets/sprites/start_background.png",
        "description": "Twilight forest with soft orange-violet gradient sky."
      },
      "music": {
        "assert_path": "./assets/sounds/start_theme.wav",
        "description": "Gentle intro melody building anticipation."
      }
    }
  },
  "screens": {
    "game_screen": {
      "screen": { "width": 500, "height": 600, "frame_rate": 60, "scroll_speed": 5 },
      "background": {
        "assert_path": "./assets/sprites/scene_background.png",
        "description": "Pixel-art forest scene at sunset under a vibrant orange-purple sky."
      },
      "hud": {
        "score": { "position": { "x": 10, "y": 10 }, "font_size": 24, "color": "#FFFFFF", "label": "Score" },
        "health": { "position": { "x": 400, "y": 10 }, "font_size": 24, "color": "#FF0000", "label": "Health" }
      },
      "music": {
        "assert_path": "./assets/sounds/background_music.wav",
        "description": "Looping ambient forest track with soft wind and distant bird calls."
      }
    },
    "win_screen": {
      "message_text": "You Win!",
      "font": { "family": "ArcadeClassic", "size": 56, "color": "#00FF00" },
      "background": {
        "assert_path": "./assets/sprites/win_background.png",
        "description": "Bright clearing bathed in sunset glow."
      },
      "sound": {
        "assert_path": "./assets/sounds/win.wav",
        "description": "Short upbeat fanfare with bright horns and festive rhythm."
      }
    },
    "lose_screen": {
      "message_text": "Game Over",
      "font": { "family": "ArcadeClassic", "size": 56, "color": "#FF0000" },
      "background": {
        "assert_path": "./assets/sprites/lose_background.png",
        "description": "Dark forest under a purple-blue night sky."
      },
      "sound": {
        "assert_path": "./assets/sounds/lose.wav",
        "description": "Soft downward melody with gentle piano chords and fading echo."
      }
    }
  },
  "objects": [
    {
      "id": "player_bouncey",
      "role": "player",
      "description": "Cartoon creature mid-hop with dynamic pose and cheerful expression.",
      "assert_path": "./assets/sprites/bouncey.png",
      "health": 3,
      "score": 0,
      "controls": { "left": "K_LEFT", "right": "K_RIGHT" },
      "spawn": {
        "spawn_area": { "x_min": 0, "x_max": 500, "y_spawn": 0 }
      }
    },
    {
      "id": "apple",
      "role": "collectible",
      "description": "A single big red apple.",
      "assert_path": "./assets/sprites/apple.png",
      "score": 1,
      "spawn": {
        "infinite": true,
        "interval_sec": 1.5,
        "fall_speed": 2,
        "max_on_screen": 4,
        "spawn_area": { "x_min": 0, "x_max": 500, "y_spawn": 0 }
      }
    },
    {
      "id": "golden_apple",
      "role": "collectible",
      "description": "A single big glowing golden apple.",
      "assert_path": "./assets/sprites/golden_apple.png",
      "score": 3,
      "spawn": {
        "infinite": true,
        "interval_sec": 5,
        "fall_speed": 1.5,
        "max_on_screen": 2,
        "spawn_area": { "x_min": 0, "x_max": 500, "y_spawn": 0 }
      }
    },
    {
      "id": "stone",
      "role": "obstacle",
      "description": "A big black stone with rough edges and visible cracks texture.",
      "assert_path": "./assets/sprites/stone.png",
      "damage": 1,
      "spawn": {
        "infinite": true,
        "interval_sec": 1.2,
        "fall_speed": 1,
        "max_on_screen": 4,
        "spawn_area": { "x_min": 0, "x_max": 500, "y_spawn": 0 }
      }
    },
    {
      "id": "bee",
      "role": "obstacle",
      "description": "A big flying bee with translucent wings and a buzzing movement.",
      "assert_path": "./assets/sprites/bee.png",
      "damage": 1,
      "spawn": {
        "infinite": true,
        "interval_sec": 0.8,
        "fall_speed": 3,
        "max_on_screen": 5,
        "spawn_area": { "x_min": 0, "x_max": 500, "y_spawn": 0 }
      }
    }
  ],
  "levels": [
    { "id": "level_1", "name": "Starter Grove", "objects": ["player_bouncey","apple","stone"] },
    { "id": "level_2", "name": "Golden Hunt", "objects": ["player_bouncey","apple","golden_apple","stone"] },
    { "id": "level_3", "name": "Bee Trouble", "objects": ["player_bouncey","apple","stone","bee"] }
  ],
  "gameplay": {
    "type": "score",
    "target": 20,
    "rules": [
      { "on": "apple", "effect": "+1 point", "assert_path": "./assets/sounds/apple_catch.wav", "description": "Quick bright chime on apple catch with crisp, uplifting tone." },
      { "on": "golden_apple", "effect": "+3 points", "assert_path": "./assets/sounds/golden_apple.wav", "description": "Sparkle sound for gold apple with shimmering high notes softly." },
      { "on": "stone", "effect": "-1 health", "assert_path": "./assets/sounds/stone_hit.wav", "description": "Deep thud on stone impact with low-frequency rumble effect realistic." },
      { "on": "bee", "effect": "-1 health", "assert_path": "./assets/sounds/bee_sting.wav", "description": "Sharp buzz sting effect with quick fade-out and subtle ending." }
    ]
  }
}
